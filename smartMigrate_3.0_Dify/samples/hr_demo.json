          "SQL_SEQ": 1,
          "SPACE_NM": "HR_DEMO",
          "SQL_ID": "EMP_DEPT_TUNING_DEMO",
          "REF_SEQ": null,
          "STATUS_CONVERSION": null,
          "STATUS_TUNING": null,
          "PRIORITY": 1,
          "USER_EDITED": "N",
          "TARGET_TABLE": "ASIS_HR_EMP,ASIS_HR_DEPT",
          "TAG_KIND": "SELECT",
          "FR_SQL": "SELECT e.EMPLOYEE_ID, e.FIRST_NAME, d.DEPARTMENT_NAME, e.SALARY\nFROM ASIS_HR_EMP e, ASIS_HR_DEPT d\nWHERE e.DEPARTMENT_ID = d.DEPARTMENT_ID(+)\n  AND e.DEPARTMENT_ID = :dept_id\n  AND e.EMPLOYEE_ID IN (\n    SELECT s.EMPLOYEE_ID FROM ASIS_HR_EMP s\n    WHERE s.SALARY >= :min_salary\n  )\nORDER BY e.EMPLOYEE_ID",
          "EDIT_FR_SQL": null,
          "TO_SQL": null,
          "BIND_SQL": null,
          "BIND_SET": "{\"dept_id\": 20, \"min_salary\": 7000}",
          "TEST_SQL": null,
